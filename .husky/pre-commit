# Architecture validation pre-commit hook
echo "🏗️  Running architecture validation..."

# Check only changed files for faster feedback
CHANGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|js)$' || true)

if [ -n "$CHANGED_FILES" ]; then
    echo "Validating $(echo "$CHANGED_FILES" | wc -l) changed files..."
    
    # If StatusBarService or other critical files changed, run full validation
    if echo "$CHANGED_FILES" | grep -E "(status-bar|button-state|execution-engine)" > /dev/null; then
        echo "🔍 Critical service changed - running full architecture validation..."
        npm run validate:architecture
        if [ $? -ne 0 ]; then
            echo "❌ Architecture violations found! Fix before committing."
            exit 1
        fi
    fi
fi

echo "✅ Architecture validation passed!"

# Issue #326: the core boundary — no vscode imports, no `global` host services in core
if [ -n "$CHANGED_FILES" ]; then
    npm run lint:core --silent
    if [ $? -ne 0 ]; then
        echo "❌ Core boundary broken (scripts/core-modules.json). Inject the host service instead."
        exit 1
    fi
fi

# Issue #325: the core lane — batch engine end to end in plain Node, no VS Code (~15 s)
if [ -n "$CHANGED_FILES" ]; then
    echo "🧪 Running test:core..."
    npm run test:core --silent > /tmp/dbmn-test-core.log 2>&1
    if [ $? -ne 0 ]; then
        tail -40 /tmp/dbmn-test-core.log
        echo "❌ test:core failed (full log: /tmp/dbmn-test-core.log). Fix before committing."
        exit 1
    fi
    grep -E "passing" /tmp/dbmn-test-core.log
fi