.claude/settings.local.json
.claude/*.lock

# npm run dev:local — pids and logs of the local backend
.dev-local/

# Playwright UI tests (see playwright.config.ts)
playwright-report/

# Disposable test Supabase stack (scripts/supabase-test-stack.mjs)
.supabase-test/

# Never compiled output next to the web app's sources (Vite builds web/)
web/src/**/*.js
web/src/**/*.js.map

# The desktop app (Electron): packages, and the web app's export for it
desktop/release/
web/dist-desktop/
